# ============================================================
# Argus — Environment Variables
#
# Copy this file to .env and fill in your credentials.
# The .env file is loaded automatically at startup via
# python-dotenv. Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Anthropic API — required for LLM summarization.
# Get your key at: https://console.anthropic.com/keys
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------
# SMTP credentials — required when email.provider = "smtp".
#
# Gmail users: generate an App Password (not your account
# password) at: https://myaccount.google.com/apppasswords
# You must have 2-Step Verification enabled on the account.
# ----------------------------------------------------------
SMTP_USER=argus@yourcompany.com
SMTP_PASSWORD=your-app-password-here

# ----------------------------------------------------------
# SendGrid — required only when email.provider = "sendgrid".
# Get your key at: https://app.sendgrid.com/settings/api_keys
# Also install the optional dependency: pip install sendgrid
# ----------------------------------------------------------
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
